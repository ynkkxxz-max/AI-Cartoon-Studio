# Copy to .env locally. Replace BOTH placeholders; startup rejects invalid keys.
DATABASE_URL=postgresql://studio:CHANGE_ME@127.0.0.1:5433/studio?schema=public&connection_limit=5&pool_timeout=5&connect_timeout=5&socket_timeout=5
OWNER_API_KEYS=[{"ownerId":"11111111-1111-4111-8111-111111111111","token":"REPLACE_WITH_RANDOM_TOKEN"}]
PORT=8002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT=120
# Compose requires a local password; never commit its value.
POSTGRES_PASSWORD=CHANGE_ME
